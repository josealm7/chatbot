# ── Grok ────────────────────────────────────────────
GROQ_API_KEY=gsk_tu-key-aquí
# ── Vector Store ─────────────────────────────────────────
# Opciones: "chroma" (local, sin cuenta) | "pinecone" (cloud)
VECTOR_STORE=chroma

# Solo necesario si VECTOR_STORE=pinecone
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=smartchat-docs

# ── App Config ───────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-in-production-please
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ── ChromaDB (si usas local) ─────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db

# ── Empresa / Bot Config ─────────────────────────────────
# (También se puede cambiar desde la API)
DEFAULT_COMPANY_NAME=Mi Empresa S.L.
DEFAULT_BOT_NAME=Asistente Virtual
DEFAULT_INDUSTRY=seguros
